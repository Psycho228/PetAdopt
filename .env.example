# .env - Секретные переменные (НЕ КОММИТИТЬ В GIT!)
# Скопируйте этот файл в .env.local и заполните своими значениями

# S3 Configuration (reg.ru Cloud)
S3_ACCESS_KEY=your_access_key_here
S3_SECRET_KEY=your_secret_key_here
S3_BUCKET_NAME=pet-photos
S3_ENDPOINT_URL=https://s3.regru.cloud

# GigaChat Configuration
GIGACHAT_CLIENT_ID=your_client_id_here
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_AUTH_KEY=your_auth_key_here

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
